# ============================================================
# Claric SaaS — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Claric"
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/claric_saas?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/claric_saas?schema=public"

# Auth (NextAuth.js v5)
AUTH_SECRET="your-super-secret-auth-secret-min-32-chars"
AUTH_URL=http://localhost:3000

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# AWS S3 / Cloudflare R2
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=claric-files
# For Cloudflare R2, set this to your R2 endpoint:
# AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="Claric <noreply@yourdomain.com>"

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Square
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=your_location_id
SQUARE_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_key

# QuickBooks
QUICKBOOKS_CLIENT_ID=your_qbo_client_id
QUICKBOOKS_CLIENT_SECRET=your_qbo_client_secret
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback

# Pusher (Realtime)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# Encryption key for sensitive data (32 chars)
ENCRYPTION_KEY="your-32-character-encryption-key!!"

# Super Admin (seeded on first run)
SUPER_ADMIN_EMAIL=admin@claric.io
SUPER_ADMIN_PASSWORD=ChangeMe123!


NEXT_PUBLIC_STRIPE_CLIENT_ID
STRIPE_SECRET_KEY

http://localhost:3000/api/integrations/stripe/callback